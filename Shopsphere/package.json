{
  "name": "shopsphere-microservices-application",
  "version": "1.0.0",
  "private": true,
  "description": "ShopSphere e-commerce microservices application",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node gateway/server.js",
    "start:gateway": "node gateway/server.js",
    "start:auth": "node services/auth/server.js",
    "start:product": "node services/product/server.js",
    "start:cart": "node services/cart/server.js",
    "start:order": "node services/order/server.js",
    "start:payment": "node services/payment/server.js",
    "test": "node --test tests/integration.test.js",
    "test:smoke": "node --test tests/smoke.test.js"
  }
}
